{
  "name": "mladenruzicic-ask",
  "version": "1.0.0",
  "private": true,
  "description": "The Ask assistant's backend: a Cloudflare Worker on Workers AI.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "context": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs ../../scripts/build-ask-context.ts",
    "context:check": "pnpm run context --check",
    "measure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/measure.ts",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run context:check && vitest run",
    "dev": "pnpm run context && pnpm run questions migrate --local && wrangler dev",
    "eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/eval.ts",
    "build": "pnpm run context && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm run context && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/deploy-config.ts && wrangler deploy --config wrangler.deploy.json",
    "notes:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/notes.ts check",
    "notes:upload": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/notes.ts upload",
    "notes:delete": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/notes.ts delete",
    "questions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../scripts/ts-register.mjs scripts/questions.ts"
  },
  "devDependencies": {
    "gpt-tokenizer": "4.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
